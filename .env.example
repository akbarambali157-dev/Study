# Both values are PUBLIC by design (they ship in the browser bundle).
# They are safe only because every table has row-level security.
# Find them in Supabase → Project Settings → API.
#
# Leave these empty to run the app in local mode: everything is stored in the
# browser's IndexedDB and no account is required. Useful for trying the app out.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: force a backend. "supabase" | "local". Auto-detected when unset.
# VITE_DATA_BACKEND=local

# Optional: an Anthropic-compatible gateway URL for non-Anthropic gateway tokens.
# Leave blank when using a personal Anthropic key; it goes directly to Anthropic.
# A URL is public, so it can live here; never put an API key in a VITE_ variable.
VITE_AI_BASE_URL=

# The shared BrewKeg provider is the default. Its API key belongs in the
# Supabase Edge Function secret BREWKEG_API_KEY, never in this file.
# Set VITE_AI_PROXY=false only for a local BYOK-only development build.
VITE_AI_PROXY=true
