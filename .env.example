# Both values are PUBLIC by design (they ship in the browser bundle).
# They are safe only because every table has row-level security.
# Find them in Supabase → Project Settings → API.
#
# Leave these empty to run the app in local mode: everything is stored in the
# browser's IndexedDB and no account is required. Useful for trying the app out.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: force a backend. "supabase" | "local". Auto-detected when unset.
# VITE_DATA_BACKEND=local

# Optional: the AI endpoint. Blank means https://api.anthropic.com. A URL is
# public, so it can live here; the key itself must NEVER be a VITE_ variable,
# because that would bake it into the bundle for every visitor.
VITE_AI_BASE_URL=https://brewkeg.dev

# When true, the site provides the model via the Supabase Edge Function
# (ai-proxy). Students never paste their own key. The brewkeg.dev key lives
# server-side in Supabase Edge Function secrets, never in this file.
VITE_AI_PROXY=false
